<?xml version="1.0" encoding="utf-8"?>
<!-- Léger agrandissement au focus : la convention Android TV, qui rend la position
     lisible de loin même en vision périphérique. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.06"
                android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.06"
                android:duration="150" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0"
                android:duration="150" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0"
                android:duration="150" android:valueType="floatType" />
        </set>
    </item>
</selector>
