<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de configuration, navigable à la télécommande (D-pad).

     fadingEdgeLength réserve une marge haute et basse au défilement automatique :
     sans elle, le ScrollView posait l'élément focalisé pile sur le bord bas de l'écran,
     sous la zone sûre d'overscan, et on ne voyait jamais ce qui venait ensuite. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418"
    android:requiresFadingEdge="vertical"
    android:fadingEdgeLength="96dp">

    <LinearLayout
        android:layout_width="860dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="32dp">

        <TextView
            style="@style/ConfigTitle"
            android:text="@string/app_name" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/server_url"
            android:text="@string/config_server_url" />
        <EditText
            android:id="@id/server_url"
            style="@style/ConfigField"
            android:hint="@string/config_server_url_hint"
            android:inputType="textUri" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/username"
            android:text="@string/config_username" />
        <EditText
            android:id="@id/username"
            style="@style/ConfigField"
            android:inputType="text" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/app_password"
            android:text="@string/config_app_password" />
        <EditText
            android:id="@id/app_password"
            style="@style/ConfigField"
            android:inputType="textPassword" />

        <!-- 29 caractères saisis à la télécommande : pouvoir les relire évite de tout refaire -->
        <CheckBox
            android:id="@+id/show_password"
            style="@style/ConfigCheckBox"
            android:text="@string/config_show_password" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/folder_path"
            android:text="@string/config_folder" />
        <EditText
            android:id="@id/folder_path"
            style="@style/ConfigField"
            android:hint="@string/config_folder_hint"
            android:inputType="text" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/slide_interval"
            android:text="@string/config_slide_interval" />
        <EditText
            android:id="@id/slide_interval"
            style="@style/ConfigField"
            android:inputType="number" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/sync_interval"
            android:text="@string/config_sync_interval" />
        <EditText
            android:id="@id/sync_interval"
            style="@style/ConfigField"
            android:inputType="number" />

        <TextView
            style="@style/ConfigLabel"
            android:labelFor="@+id/max_cache"
            android:text="@string/config_max_cache" />
        <EditText
            android:id="@id/max_cache"
            style="@style/ConfigField"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/show_clock"
            style="@style/ConfigCheckBox"
            android:layout_marginTop="16dp"
            android:text="@string/config_show_clock" />

        <CheckBox
            android:id="@+id/show_photo_info"
            style="@style/ConfigCheckBox"
            android:text="@string/config_show_photo_info" />

        <!-- Au-dessus des boutons : placé en dessous, le message de résultat restait
             sous le bord de l'écran au moment précis où l'on appuyait. -->
        <TextView
            android:id="@+id/status"
            style="@style/ConfigStatus" />

        <!-- Boutons empilés, un par ligne : en rangée, revenir d'en bas ramenait sur
             « Enregistrer » et non sur le bouton que l'on venait de quitter. -->
        <Button
            android:id="@+id/save_button"
            style="@style/ConfigButton"
            android:layout_marginTop="16dp"
            android:text="@string/config_save" />

        <Button
            android:id="@+id/test_button"
            style="@style/ConfigButton"
            android:text="@string/config_test" />

        <TextView
            android:id="@+id/screensaver_hint"
            style="@style/ConfigLabel"
            android:layout_marginTop="28dp"
            android:text="@string/config_screensaver_hint"
            android:visibility="gone" />

        <!-- Masqué si l'appareil n'expose aucun écran de réglages atteignable -->
        <Button
            android:id="@+id/screensaver_settings_button"
            style="@style/ConfigButton"
            android:text="@string/config_screensaver_settings"
            android:visibility="gone" />

        <!-- Mise à jour : le bouton n'apparaît que si une version plus récente existe -->
        <TextView
            android:id="@+id/update_status"
            style="@style/ConfigStatus"
            android:layout_marginTop="28dp"
            android:textColor="#90FFFFFF" />

        <Button
            android:id="@+id/update_button"
            style="@style/ConfigButton"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
